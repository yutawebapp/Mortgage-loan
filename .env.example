# Copy to .env and adjust. Never commit .env.
DB_NAME=mortgage
DB_USER=mortgage
DB_PASSWORD=change-me
# Public URL of the frontend (no trailing slash). Used for canonical/OG URLs, sitemap.xml and robots.txt.
# Baked into the frontend at build time, so rebuild the frontend image after changing it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
